# Database configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_SSL_MODE=disable
DB_POOL_IDLE=10
DB_MAX_POOL=50
DB_MAX_LIFETIME=30m

# PgAdmin configuration
PGADMIN_DEFAULT_EMAIL=postgres@example.com
PGADMIN_DEFAULT_PASSWORD=secret
PGADMIN_PORT=5050

# App configuration
APP_NAME=server
APP_MODE=dev
APP_PORT=3000
APP_PREFORK=false
APP_COOKIE_EXPIRATION_TIME=30
APP_CORS_ALLOWED_ORIGINS=*
APP_RESET_SECRET=changeme-secret

# Email (SMTP) configuration — leave blank to disable email sending
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=SIMBA
