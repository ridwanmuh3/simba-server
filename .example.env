# Database configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_SSL_MODE=disable
DB_POOL_IDLE=10
DB_MAX_POOL=100
DB_MAX_LIFETIME=300

# PgAdmin configuration
PGADMIN_DEFAULT_EMAIL=postgres@example.com
PGADMIN_DEFAULT_PASSWORD=secret
PGADMIN_PORT=5050

# app configuration
APP_NAME=server
APP_PREFORK=false
APP_PORT=3000
APP_MODE=false
APP_COOKIE_EXPIRATION_TIME=30
JWT_SECRET=secret